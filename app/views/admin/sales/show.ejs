<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt"></i> Sale Details</h2>
    <div>
        <a href="/admin/sales/<%= sale._id %>/edit" class="btn btn-outline-primary me-2">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="/admin/customers/<%= sale.customer._id %>" class="btn btn-outline-secondary me-2">
            <i class="bi bi-person"></i> View Customer
        </a>
        <a href="/admin/sales" class="btn btn-outline-secondary">Back to Sales</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Sale Information</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Customer:</strong><br>
                        <a href="/admin/customers/<%= sale.customer._id %>"><%= sale.customer.name %></a><br>
                        <% if (sale.customer.email) { %>
                            <small class="text-muted"><%= sale.customer.email %></small>
                        <% } %>
                    </div>
                    <div class="col-md-6">
                        <strong>Sale Date:</strong> <%= new Date(sale.saleDate).toLocaleDateString() %><br>
                        <strong>Created:</strong> <%= new Date(sale.createdAt).toLocaleString() %>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        <span class="badge bg-<%= sale.status === 'paid' ? 'success' : sale.status === 'cancelled' ? 'danger' : sale.status === 'draft' ? 'secondary' : 'warning' %> ms-2">
                            <%= sale.status %>
                        </span>
                    </div>
                    <div class="col-md-6">
                        <strong>Payment Status:</strong>
                        <span class="badge bg-<%= sale.paymentStatus === 'paid' ? 'success' : sale.paymentStatus === 'partial' ? 'warning' : 'danger' %> ms-2">
                            <%= sale.paymentStatus %>
                        </span>
                    </div>
                </div>

                <% if (sale.notes) { %>
                    <div class="mb-3">
                        <strong>Notes:</strong>
                        <div class="card bg-light p-2 mt-2">
                            <%= sale.notes.replace(/\n/g, '<br>') %>
                        </div>
                    </div>
                <% } %>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Taxable</th>
                                <th>Subtotal</th>
                                <th>Tax</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% sale.lineItems.forEach(item => { %>
                                <tr>
                                    <td>
                                        <strong><%= item.name %></strong>
                                        <% if (item.description) { %>
                                            <br><small class="text-muted"><%= item.description %></small>
                                        <% } %>
                                    </td>
                                    <td><%= item.sku || '-' %></td>
                                    <td><%= item.quantity %></td>
                                    <td>$<%= item.unitPrice.toFixed(2) %></td>
                                    <td>
                                        <% if (item.taxable) { %>
                                            <span class="badge bg-success">Yes</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">No</span>
                                        <% } %>
                                    </td>
                                    <td>$<%= item.lineSubtotal.toFixed(2) %></td>
                                    <td>$<%= item.lineTax.toFixed(2) %></td>
                                    <td><strong>$<%= item.lineTotal.toFixed(2) %></strong></td>
                                </tr>
                            <% }); %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end"><strong>Subtotal:</strong></td>
                                <td><strong>$<%= sale.subtotal.toFixed(2) %></strong></td>
                                <td colspan="2"></td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-end"><strong>Tax (<%= (sale.taxRate * 100).toFixed(2) %>%):</strong></td>
                                <td colspan="1"></td>
                                <td><strong>$<%= sale.taxTotal.toFixed(2) %></strong></td>
                                <td colspan="1"></td>
                            </tr>
                            <tr class="table-primary">
                                <td colspan="5" class="text-end"><strong>Total:</strong></td>
                                <td colspan="2"></td>
                                <td><strong>$<%= sale.total.toFixed(2) %></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Tax Rate:</strong> <%= (sale.taxRate * 100).toFixed(2) %>%
                </div>
                <div class="mb-3">
                    <strong>Line Items:</strong> <%= sale.lineItems.length %>
                </div>
                <div class="mb-3">
                    <strong>Subtotal:</strong> $<%= sale.subtotal.toFixed(2) %>
                </div>
                <div class="mb-3">
                    <strong>Tax Total:</strong> $<%= sale.taxTotal.toFixed(2) %>
                </div>
                <div class="mb-0">
                    <h4>Grand Total: $<%= sale.total.toFixed(2) %></h4>
                </div>
            </div>
        </div>
    </div>
</div>
