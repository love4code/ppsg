<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-circle"></i> Create New Sale</h2>
    <a href="<%= customer ? '/admin/customers/' + customer._id : '/admin/sales' %>" class="btn btn-outline-secondary">Cancel</a>
</div>

<div class="card">
    <div class="card-body">
        <form action="<%= customer ? '/admin/customers/' + customer._id + '/sales' : '/admin/sales' %>" method="POST" id="saleForm">
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label for="customer" class="form-label">Customer *</label>
                    <% if (customer) { %>
                        <input type="hidden" name="customer" value="<%= customer._id %>">
                        <input type="text" class="form-control" value="<%= customer.name %>" disabled>
                    <% } else { %>
                        <select class="form-select" id="customer" name="customer" required>
                            <option value="">Select a customer...</option>
                            <% customers.forEach(cust => { %>
                                <option value="<%= cust._id %>"><%= cust.name %> <% if (cust.email) { %>(<%= cust.email %>)<% } %></option>
                            <% }); %>
                        </select>
                    <% } %>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="saleDate" class="form-label">Sale Date *</label>
                    <input type="date" class="form-control" id="saleDate" name="saleDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="taxRate" class="form-label">Tax Rate (%)</label>
                    <input type="number" class="form-control" id="taxRate" name="taxRate" step="0.0001" min="0" max="100" value="6.25" required>
                    <small class="form-text text-muted">Default: 6.25%</small>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="open" selected>Open</option>
                        <option value="draft">Draft</option>
                        <option value="paid">Paid</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="paymentStatus" class="form-label">Payment Status</label>
                    <select class="form-select" id="paymentStatus" name="paymentStatus">
                        <option value="unpaid" selected>Unpaid</option>
                        <option value="partial">Partial</option>
                        <option value="paid">Paid</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="notes" class="form-label">Notes</label>
                    <textarea class="form-control" id="notes" name="notes" rows="2"></textarea>
                </div>
            </div>

            <hr>

            <h5 class="mb-3">Line Items</h5>

            <div class="mb-3" style="position: relative;">
                <div class="input-group">
                    <input type="text" class="form-control" id="productSearch" placeholder="Search products...">
                    <button type="button" class="btn btn-outline-primary" id="addProductBtn">
                        <i class="bi bi-plus"></i> Add Product
                    </button>
                    <button type="button" class="btn btn-outline-success" id="createProductBtn" data-bs-toggle="modal" data-bs-target="#createProductModal">
                        <i class="bi bi-plus-circle"></i> New Product
                    </button>
                </div>
                <div id="productSearchResults" class="list-group mt-2" style="position: absolute; z-index: 1000; max-height: 200px; overflow-y: auto; display: none; width: 100%;"></div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered" id="lineItemsTable">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>Quantity</th>
                            <th>Cost</th>
                            <th>Unit Price</th>
                            <th>Taxable</th>
                            <th>Subtotal</th>
                            <th>Tax</th>
                            <th>Total</th>
                            <th>Profit</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="lineItemsBody">
                        <!-- Line items will be added here dynamically -->
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Subtotal:</strong></td>
                            <td><strong id="previewSubtotal">$0.00</strong></td>
                            <td colspan="1"></td>
                            <td colspan="1"></td>
                            <td colspan="1"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Tax:</strong></td>
                            <td colspan="1"></td>
                            <td><strong id="previewTaxTotal">$0.00</strong></td>
                            <td colspan="1"></td>
                            <td colspan="1"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Total Cost:</strong></td>
                            <td colspan="2"></td>
                            <td colspan="1"></td>
                            <td><strong id="previewTotalCost">$0.00</strong></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end"><strong>Total Profit:</strong></td>
                            <td colspan="2"></td>
                            <td colspan="1"></td>
                            <td><strong id="previewTotalProfit">$0.00</strong></td>
                            <td></td>
                        </tr>
                        <tr class="table-primary">
                            <td colspan="6" class="text-end"><strong>Grand Total:</strong></td>
                            <td colspan="2"></td>
                            <td><strong id="previewTotal">$0.00</strong></td>
                            <td colspan="1"></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Sale</button>
                <a href="<%= customer ? '/admin/customers/' + customer._id : '/admin/sales' %>" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<!-- Create Product Modal -->
<div class="modal fade" id="createProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createProductForm">
                    <div class="mb-3">
                        <label for="newProductName" class="form-label">Product Name *</label>
                        <input type="text" class="form-control" id="newProductName" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="newProductDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="newProductDescription" name="description" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="newProductSKU" class="form-label">SKU</label>
                            <input type="text" class="form-control" id="newProductSKU" name="sku">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="newProductStatus" class="form-label">Status</label>
                            <select class="form-select" id="newProductStatus" name="status">
                                <option value="draft">Draft</option>
                                <option value="published">Published</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="newProductCost" class="form-label">Cost</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="newProductCost" name="cost" step="0.01" min="0" value="0">
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="newProductPrice" class="form-label">Price *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="newProductPrice" name="price" step="0.01" min="0" value="0" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="newProductTaxable" name="isTaxable" checked>
                            <label class="form-check-label" for="newProductTaxable">Taxable</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveNewProductBtn">
                    <i class="bi bi-check"></i> Create & Add to Sale
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin-sales.js"></script>


