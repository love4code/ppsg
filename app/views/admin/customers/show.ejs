<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person"></i> Customer Details</h2>
    <div>
        <a href="/admin/customers/<%= customer._id %>/sales/new" class="btn btn-primary me-2">
            <i class="bi bi-cart-plus"></i> Create Sale
        </a>
        <a href="/admin/customers/<%= customer._id %>/edit" class="btn btn-outline-primary me-2">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="/admin/customers" class="btn btn-outline-secondary">Back to Customers</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Customer Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Name:</strong> <%= customer.name %>
                </div>
                <div class="mb-3">
                    <strong>Email:</strong> 
                    <% if (customer.email) { %>
                        <a href="mailto:<%= customer.email %>"><%= customer.email %></a>
                    <% } else { %>
                        <span class="text-muted">Not provided</span>
                    <% } %>
                </div>
                <div class="mb-3">
                    <strong>Phone:</strong> 
                    <%= customer.phone || '<span class="text-muted">Not provided</span>' %>
                </div>
                <div class="mb-3">
                    <strong>Status:</strong>
                    <span class="badge bg-<%= customer.status === 'active' ? 'success' : 'secondary' %> ms-2">
                        <%= customer.status %>
                    </span>
                </div>
                <% if (customer.address && (customer.address.street || customer.address.city)) { %>
                    <div class="mb-3">
                        <strong>Address:</strong><br>
                        <% if (customer.address.street) { %>
                            <%= customer.address.street %><br>
                        <% } %>
                        <%= customer.address.city || '' %>
                        <% if (customer.address.state) { %>, <%= customer.address.state %><% } %>
                        <% if (customer.address.zip) { %> <%= customer.address.zip %><% } %>
                    </div>
                <% } %>
                <% if (customer.notes) { %>
                    <div class="mb-3">
                        <strong>Notes:</strong>
                        <div class="card bg-light p-2 mt-2">
                            <%= customer.notes.replace(/\n/g, '<br>') %>
                        </div>
                    </div>
                <% } %>
                <div class="mb-0">
                    <strong>Created:</strong> <%= new Date(customer.createdAt).toLocaleString() %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Recent Sales</h5>
            </div>
            <div class="card-body">
                <% if (sales && sales.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% sales.forEach(sale => { %>
                                    <tr>
                                        <td><%= new Date(sale.saleDate).toLocaleDateString() %></td>
                                        <td>
                                            <span class="badge bg-<%= sale.status === 'paid' ? 'success' : sale.status === 'cancelled' ? 'danger' : 'warning' %>">
                                                <%= sale.status %>
                                            </span>
                                        </td>
                                        <td>$<%= sale.total.toFixed(2) %></td>
                                        <td>
                                            <a href="/admin/sales/<%= sale._id %>" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-2">
                        <a href="/admin/sales?customer=<%= customer._id %>" class="btn btn-sm btn-outline-primary">View All Sales</a>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">No sales found for this customer.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

